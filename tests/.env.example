# Copy to .env to override defaults. All values are optional.

# Backend / frontend URLs the suite talks to
API_URL=http://localhost:5294/api
UI_URL=http://localhost:5173

# Isolated database used by the backend while tests run (never the dev DB)
TEST_DB_CONNECTION=Server=(localdb)\MSSQLLocalDB;Database=PetStore_Test;TrustServerCertificate=True;Trusted_Connection=True

# Optional: fixed JWT key for the test backend (random per run when unset)
# TEST_JWT_SECRET=
